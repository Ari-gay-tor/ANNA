# Copy to .env and edit. .env is gitignored. Never commit a real key.
# Restart the server after editing. Full guide: docs/providers.md
# A .env in the ANNA folder means dev mode: the data stays in this folder (docs/app.md). The tester kit has no .env;
# there the key is entered in the app and saved to %LOCALAPPDATA%\ANNA\config.env.

# Which LLM provider(s) to use. One name, or a comma-separated fallback list (first is tried first):
#   gemini | openai-compatible | fake
# Examples: ANNA_PROVIDER=gemini
#           ANNA_PROVIDER=gemini,openai-compatible   (local model when Gemini is down or out of quota)
# "fake" needs no key; it echoes a canned reply, for working on the UI offline.
ANNA_PROVIDER=gemini

# --- Gemini ---------------------------------------------------------------
# API key from https://aistudio.google.com/apikey (use a project without billing).
GEMINI_API_KEY=

# Primary model.
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated models tried in order when the previous one is out of quota (HTTP 429)
# or overloaded (HTTP 503, HTTP 504, or no answer within GEMINI_TIMEOUT_MS). Each model
# is tried at most once per reply. Free-tier limits are per model (some as low as 20
# requests a day), so a longer list gives more free replies per day. Leave blank to disable fallbacks.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Per-attempt timeout in milliseconds. Each model in the chain gets its own.
GEMINI_TIMEOUT_MS=20000

# --- OpenAI-compatible (Ollama, LM Studio, OpenRouter, Groq, ...) ----------
# Only needed when ANNA_PROVIDER includes openai-compatible.
# Ollama:    http://localhost:11434/v1     LM Studio: http://localhost:1234/v1
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=llama3.1:8b
# Optional. Leave unset for local servers; no Authorization header is sent when empty.
# OPENAI_COMPAT_API_KEY=
# Per-request timeout in milliseconds (local models are slow).
# OPENAI_COMPAT_TIMEOUT_MS=60000
# How to ask for JSON: json_schema (default) | json_object | none
# OPENAI_COMPAT_JSON_MODE=json_schema

# --- Database ---------------------------------------------------------------
# SQLite file, relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# --- Running ANNA as a Windows app (docs/app.md) ----------------------------
# Port the app server listens on (127.0.0.1 only). Default 3737. Restart ANNA after changing it.
# ANNA_PORT=3737
# Windows toast when a reminder fires, even with the ANNA window closed. Default on (Windows only); "off" disables it.
# ANNA_DESKTOP_NOTIFICATIONS=off
