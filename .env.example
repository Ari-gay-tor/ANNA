# Copy to .env and edit. .env is gitignored. Never commit a real key.

# Which LLM provider to use: "gemini" (default) or "fake".
# "fake" needs no key; it echoes a canned reply, for working on the UI offline.
ANNA_PROVIDER=gemini

# Gemini API key from https://aistudio.google.com/apikey (use a project without billing).
GEMINI_API_KEY=

# Primary model.
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated models tried in order when the previous one is overloaded (HTTP 503).
# Quota errors (429) are never retried. Leave blank to disable fallbacks.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# SQLite file, relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"
